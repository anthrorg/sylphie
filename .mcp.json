{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "@playwright/mcp"
      ]
    },
    "railway-mcp-server": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@railway/mcp-server"
      ]
    },
    "codebase-pkg": {
      "command": "npx",
      "args": [
        "-y",
        "--package",
        "@sylphie-labs/codebase-pkg",
        "codebase-pkg-mcp"
      ],
      "env": {
        "CODEBASE_PKG_PACKAGES": "[{\"name\":\"sylphie\",\"dir\":\"apps/sylphie/src\"},{\"name\":\"drive-server\",\"dir\":\"apps/drive-server/src\"},{\"name\":\"decision-making\",\"dir\":\"packages/decision-making/src\"},{\"name\":\"drive-engine\",\"dir\":\"packages/drive-engine/src\"},{\"name\":\"learning\",\"dir\":\"packages/learning/src\"},{\"name\":\"planning\",\"dir\":\"packages/planning/src\"},{\"name\":\"shared\",\"dir\":\"packages/shared/src\"},{\"name\":\"supervisor\",\"dir\":\"packages/supervisor/src\"},{\"name\":\"frontend\",\"dir\":\"frontend/src\"},{\"name\":\"cognition-service\",\"dir\":\"packages/cognition-service\"},{\"name\":\"perception-service\",\"dir\":\"packages/perception-service\"}]"
      }
    }
  }
}
