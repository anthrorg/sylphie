# Copy to .env.local (gitignored) for local dev, or set in the Railway
# sylphie-app service's Variables tab for production.
#
# Vite reads VITE_* vars at build time and inlines them into the bundle.
# A new deploy is required after changing either of these.

# PostHog (autocapture, heatmaps, session recordings, product analytics).
# Project token from https://us.posthog.com/project/settings under
# "Project API Key" (starts with phc_). Leave unset to disable analytics.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=

# PostHog host. Defaults to https://us.i.posthog.com — set explicitly only
# for EU cloud (https://eu.i.posthog.com) or self-hosted.
VITE_PUBLIC_POSTHOG_HOST=
