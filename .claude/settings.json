{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(cd *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(ls *)",
      "Bash(rm *)",
      "Bash(node *)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/discovery-reminder.cjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/pipeline/hooks/db-change-guard.cjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "planning-worx@planning-worx-local": true
  },
  "extraKnownMarketplaces": {
    "planning-worx-local": {
      "source": {
        "source": "directory",
        "path": "./.claude/planning-worx-plugin"
      }
    }
  }
}
